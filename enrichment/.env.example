# ── Provider Selection ────────────────────────────────────────────────────
# Translation: "openai" (default) or "deepl"
TRANSLATION_PROVIDER=openai

# Audio: "gtts" (default, free) or "openai" (higher quality, paid)
AUDIO_PROVIDER=gtts

# Images: "unsplash", "pexels", or "none" (default)
# Images are only fetched for concrete nouns (classified during translation).
IMAGE_PROVIDER=none

# ── API Keys ─────────────────────────────────────────────────────────────
# Required if TRANSLATION_PROVIDER=openai or AUDIO_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Required if TRANSLATION_PROVIDER=deepl
# DEEPL_API_KEY=...

# Required if IMAGE_PROVIDER=unsplash
# UNSPLASH_ACCESS_KEY=...

# Required if IMAGE_PROVIDER=pexels
# PEXELS_API_KEY=...

# ── OpenAI Model Settings ────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ── Performance Tuning ───────────────────────────────────────────────────
# Words per translation API call (OpenAI handles up to ~80 comfortably)
TRANSLATION_BATCH_SIZE=50

# Max concurrent audio generation tasks
AUDIO_CONCURRENCY=10

# Max concurrent image download tasks
IMAGE_CONCURRENCY=5

# Save progress every N cards
CHECKPOINT_INTERVAL=50

# ── Paths ────────────────────────────────────────────────────────────────
AUDIO_DIR=audio
IMAGE_DIR=images
CHECKPOINT_FILE=.enrichment_checkpoint.json
